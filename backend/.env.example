# MongoDB connection string (Atlas or local)
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/taskflow

# Any long random string used to sign JWT login tokens
JWT_SECRET=replace-with-a-long-random-string

# Optional — defaults to 5000 locally; Render sets this automatically
PORT=5000

# Comma-separated list of frontend origins allowed to call this API.
# Falls back to allowing all origins ("*") if left unset.
# Example: FRONTEND_URL=http://localhost:5173,https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173

# Optional — required only for deadline reminder emails
# If using Gmail, generate an App Password (not your regular password):
# https://myaccount.google.com/apppasswords
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-character-app-password